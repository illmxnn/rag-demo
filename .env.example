# Optional compatible remote generation. Leave blank for local deterministic mode.
GENERATION_BASE_URL=
GENERATION_API_KEY=
GENERATION_MODEL=
MAX_UPLOAD_BYTES=1048576
# Set true only after installing semantic extras and starting Qdrant.
SEMANTIC_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
RAG_STATE_PATH=data/documents.json
GENERATION_TIMEOUT_SECONDS=10
GENERATION_RETRIES=1

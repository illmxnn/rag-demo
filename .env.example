# Optional OpenAI-compatible answer generation. Leave blank for local deterministic mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_UPLOAD_BYTES=1048576
# Set true only after installing semantic extras and starting Qdrant.
SEMANTIC_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
RAG_STATE_PATH=data/documents.json
LLM_TIMEOUT_SECONDS=10
LLM_RETRIES=1
